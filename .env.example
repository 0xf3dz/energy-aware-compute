# Copy this file to .env and fill in the values.

# Storage
DATABASE_URL=postgresql://compute:compute@127.0.0.1:5432/compute

# Dashboard. A LAN bind requires DASHBOARD_TOKEN.
HOST=127.0.0.1
PORT=8090
DASHBOARD_TOKEN=

# Local inference. The server must run with --metrics.
LLAMA_URL=http://127.0.0.1:8082
LLAMA_MODEL=qwen3.5-9b
LLAMA_API_KEY=
LLAMA_API_KEY_FILE=/Users/f3dz/dev/local-inference/config/api-key
# PID of llama-server. Leave empty to match the process by name.
LLAMA_PID=

# Compute energy estimation. Run `offgrid-inference calibrate` on an idle machine
# and put the measured average power here. Without it, Wh is reported as null.
IDLE_BASELINE_W=
ENERGY_MEASURE_MAX_SECONDS=3600

# Victron VRM. Create a token in the VRM portal under Preferences, Access tokens.
VRM_TOKEN=
VRM_INSTALLATION_ID=
# REST requests cannot exceed the upstream measurement update rate.
VRM_POLL_SECONDS=5

# Forecast position of the vessel, in decimal degrees.
LATITUDE=
LONGITUDE=

# Daily briefing schedule, in UTC.
BRIEFING_HOUR_UTC=7
BRIEFING_LEAD_MINUTES=30

# Scheduling policy
BATTERY_FLOOR=40
HIGH_SOC=85
SURPLUS_MINIMUM_WATTS=250
SURPLUS_DURATION_SECONDS=300
ENERGY_MAX_AGE_SECONDS=300
POLL_SECONDS=5

# Set to 1 to run everything with mock providers and an in-memory queue.
DEMO=0
